# Copy to .env and fill in.  Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

# --- Real job sources ---------------------------------------------------
# Adzuna gives LOCAL part-time results in 16+ countries. Free key: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code for Adzuna: gb, us, ca, au, de, fr, nl, ...
JOB_COUNTRY=gb
# Comma-separated subset of: adzuna,arbeitnow,themuse,jobicy,remotive
JOB_SOURCES=adzuna,arbeitnow,themuse,jobicy,remotive
JOB_DEFAULT_QUERY=part time student weekend
